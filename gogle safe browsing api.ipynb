pip install requests
import requests
import json

API_KEY = "YOUR_GOOGLE_API_KEY"  # get from Google Cloud Console

url_to_check = "http://testsafebrowsing.appspot.com/s/phishing.html"

safe_browsing_url = f"https://safebrowsing.googleapis.com/v4/threatMatches:find?key={API_KEY}"

payload = {
    "client": {
        "clientId": "yourcompanyname",
        "clientVersion": "1.0"
    },
    "threatInfo": {
        "threatTypes": ["MALWARE", "SOCIAL_ENGINEERING", "POTENTIALLY_HARMFUL_APPLICATION", "THREAT_TYPE_UNSPECIFIED"],
        "platformTypes": ["ANY_PLATFORM"],
        "threatEntryTypes": ["URL"],
        "threatEntries": [
            {"url": url_to_check}
        ]
    }
}

response = requests.post(safe_browsing_url, json=payload)
result = response.json()

if "matches" in result:
    print("⚠️ Dangerous website detected:", result["matches"])
else:
    print("✅ Safe website")


